{
  "name": "pneuma-space-cloud",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "bench": "node bench.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node adapters/local/server.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types --env-interface CloudflareEnv --include-runtime=false adapters/cloudflare/env.d.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "miniflare": "5.20261110.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.160.0"
  }
}
